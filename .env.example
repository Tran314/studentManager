# Copy to .env and replace every placeholder with a strong random password
# (24+ characters). The previous demo defaults are intentionally weak;
# reusing them defeats the demonstration purpose.
#
# Generate a random password in PowerShell:
#   -join ((33..126) | Get-Random -Count 24 | ForEach-Object {[char]$_})
# Or in bash:
#   LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*' </dev/urandom | head -c 24 ; echo
#
# Only APP_PORT keeps a real default; everything else is a placeholder so
# `docker compose up` refuses to start with the placeholder values.

DB_PASSWORD=<set-a-24+-character-random-password>
DB_ROOT_PASSWORD=<set-a-different-24+-character-random-password>
DEMO_ADMIN_PASSWORD=<set-a-24+-character-random-password>
DEMO_STUDENT_PASSWORD=<set-a-different-24+-character-random-password>
APP_PORT=8080
