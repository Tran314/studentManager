<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><c:out value="${title}"/> · 学生管理 SIX</title>
<link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/favicon.c5af8644.svg">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.f18f8a0f.css">
<script src="${pageContext.request.contextPath}/assets/app.fdcf6db5.js" defer></script></head>
<body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">S</span><span>学生管理 <small>SIX</small></span></a>
<div class="top-right"><span class="status-dot"></span><span>校园信息工作台</span></div><c:if test="${not empty identity}"><form class="mobile-logout" action="${pageContext.request.contextPath}/logout" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="quiet" type="submit">退出登录</button></form></c:if></header>
<div class="shell">
<aside class="sidebar"><div class="sidebar-label">WORKSPACE / 工作空间</div>
<nav aria-label="主要导航">
<c:choose><c:when test="${not empty identity}">
<c:if test="${identity.admin}"><a href="${pageContext.request.contextPath}/students">▦ <span>学生管理</span></a><a href="${pageContext.request.contextPath}/students/create">＋ <span>新增学生</span></a></c:if>
<c:if test="${not identity.admin}"><a href="${pageContext.request.contextPath}/profile">◎ <span>个人中心</span></a></c:if>
<a href="${pageContext.request.contextPath}/password">◇ <span>修改密码</span></a>
</c:when><c:otherwise><a href="${pageContext.request.contextPath}/login">◎ <span>账号登录</span></a><p class="sidebar-note">没有账号？请联系管理员创建。</p></c:otherwise></c:choose>
</nav>
<div class="sidebar-bottom"><c:choose><c:when test="${not empty identity}">
<div class="account-label"><span class="avatar"><c:out value="${identity.admin ? '管' : '学'}"/></span><div><strong><c:out value="${identity.username}"/></strong><small><c:out value="${identity.admin ? '管理员' : '学生账号'}"/></small></div></div>
<form action="${pageContext.request.contextPath}/logout" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="quiet wide" type="submit">退出登录 ↗</button></form>
</c:when><c:otherwise><p>让资料井然有序，<br>让校园事务更加简单。</p></c:otherwise></c:choose>
<div class="version">STUDENT MANAGER · 2026</div></div></aside>
<main><div class="breadcrumb">工作空间 <span>/</span> <c:out value="${title}"/></div>
<c:if test="${not empty flash}"><div class="notice success" role="status"><c:out value="${flash}"/></div></c:if>
<c:if test="${not empty error}"><div class="notice error" role="alert"><c:out value="${error}"/></div></c:if>
