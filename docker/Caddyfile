# Local Caddyfile for compose.tls.yaml.
# Listens on 443 and reverse-proxies to the Tomcat app on 8080. TLS
# material is read from /certs (mounted from ./certs). For local dev,
# generate certs with mkcert; for production, use a CA-issued cert
# or replace this with a Cloudflare-DNS-challenge block.
{
    admin off
    auto_https off
}

:443 {
    tls /certs/fullchain.pem /certs/privkey.pem
    reverse_proxy app:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
    }
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header Referrer-Policy "same-origin"
}
